# Offline demo requires no model credential.
PATCHFORGE_LLM_PROVIDER=offline
PATCHFORGE_MODEL=offline-rule-agent
PATCHFORGE_DATA_DIR=.patchforge_data
PATCHFORGE_RUNS_DIR=.patchforge_runs
PATCHFORGE_USE_DOCKER=false

# To use a compatible DeepSeek endpoint, set the provider to deepseek
# and fill in your own credential in an ignored local .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
